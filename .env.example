# Copie para .env e ajuste. Valores abaixo são apenas para desenvolvimento local.
DATABASE_URL="postgresql://greencode:greencode@localhost:5434/greencode?schema=public"
# Banco usado pelo npm run test:e2e (schema separado, é apagado a cada execução)
DATABASE_URL_TESTE="postgresql://greencode:greencode@localhost:5434/greencode?schema=teste"

PORT=3000
HOST=0.0.0.0
# Gere um segredo forte em produção: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-este-segredo-de-desenvolvimento-por-um-valor-aleatorio"
JWT_EXPIRA_EM=30m
BCRYPT_CUSTO=12
LOG_LEVEL=info

# Senha do admin criado pelo seed (dev). Os demais usuários de teste usam SEED_SENHA_PADRAO.
SEED_SENHA_ADMIN="Admin@Green2026"
SEED_SENHA_PADRAO="Teste@Green2026"

# ---- AV3 ----
# Redis da fila de relatórios (BullMQ) e do rate limit distribuído. Deixe vazio para usar a fila em memória (só dev).
REDIS_URL="redis://localhost:6380"
# true = o worker roda dentro do servidor; false = rode "npm run worker" em outro processo/máquina
WORKER_EMBUTIDO=true
WORKER_CONCORRENCIA=2
# Expressão cron das análises recorrentes (vazio desliga). Padrão: todo dia às 02:00.
ANALITICA_CRON="0 2 * * *"
ANALITICA_FUSO="America/Sao_Paulo"
# Por quanto tempo o arquivo de um relatório assíncrono fica disponível para download
RELATORIO_VALIDADE_HORAS=72
RELATORIO_TENTATIVAS=3
# Rate limit: por IP em todas as rotas e por IP no login (a cota da API pública é por chave, cadastrada nela)
RATE_LIMIT_IP_POR_MINUTO=600
RATE_LIMIT_LOGIN_POR_MINUTO=10
# true quando houver proxy reverso/balanceador na frente (usa X-Forwarded-For para o IP real)
TRUST_PROXY=false
